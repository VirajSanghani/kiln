# Copy to .env (which is gitignored) before running docker compose.

# --- Postgres (db service) ---
POSTGRES_USER=kiln
POSTGRES_PASSWORD=kiln_dev_pw
POSTGRES_DB=kiln

# --- API ---
# Connection string used by the api service. Local non-docker dev can leave this
# unset to fall back to the SQLite dev database (see docs/stack.md).
DATABASE_URL=postgresql+psycopg2://kiln:kiln_dev_pw@db:5432/kiln

# --- Web ---
# Vite proxy target inside docker (browser hits /api on the web origin).
VITE_API_PROXY_TARGET=http://api:8000

# --- Auth (used from a later phase; placeholder only) ---
JWT_SECRET=change-me-in-prod
